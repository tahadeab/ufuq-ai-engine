# ════════════════════════════════════════════════════════════
# Ufuq AI Engine — إعدادات التشغيل
# انسخ هذا الملف إلى .env وعدّل القيم
# cp .env.example .env
# ════════════════════════════════════════════════════════════

# ── وضع التشغيل ───────────────────────────────────────────
# local (Ollama + BGE-M3 + Docling + Qdrant محلياً) ← الوضع الافتراضي
# openai | gemini (للتشغيل السحابي مستقبلاً)
LLM_PROVIDER=ollama
# ── CI / test mode (never calls real LLM) ────────────────
# CI_MODE=true

# ── Ollama (المحلي) ───────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# النموذج الرئيسي — اختر حسب VRAM:
#   qwen3:8b (8B, يحتاج ~10GB) أو qwen2.5:7b (7B, ~6GB) أو llama3.1:8b
OLLAMA_CHAT_MODEL=qwen2.5:7b
# نموذج صغير للمهام الخفيفة (التلخيص/التحقق) — يوفر VRAM
OLLAMA_SMALL_MODEL=llama3.2:3b

# ── Cloud (للاستخدام المستقبلي فقط) ────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=AI...
# GEMINI_MODEL=gemini-2.0-flash

# ── Embeddings ─────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# ── Reranker ───────────────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_TOP_K=10
RAG_DEFAULT_TOP_K=10
RAG_HYBRID_K=20

# ── Qdrant ─────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ufuq_chunks

# ── Database (اختياري في MVP — graph store) ────────────────
DATABASE_URL=postgresql+asyncpg://ufuq:ufuq_secret@localhost:5432/ufuq

# ── Agent ──────────────────────────────────────────────────
AGENT_MAX_RETRIES=3
AGENT_MAX_STEPS=50

# ── Knowledge ──────────────────────────────────────────────
MIN_RELATIONSHIP_CONFIDENCE=0.75
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ── التخزين المحلي ─────────────────────────────────────────
LOCAL_STORAGE_DIR=./local_storage

# ── Server ─────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── GPU ────────────────────────────────────────────────────
# CUDA_VISIBLE_DEVICES=0
# CUDA_MAX_MEMORY_FRACTION=0.85
